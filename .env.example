# Cloudflare Worker Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# ============================================================================
# BASE URL - CRITICAL FOR OAUTH REDIRECT URIs
# ============================================================================
# This MUST be your Cloudflare Worker URL (not your frontend URL)
# Used for OAuth redirect URIs in provider consoles
#
# CANONICAL FORMAT: https://multipost-seo-worker.alexbryant.work
#   ✅ Correct:   https://your-worker.workers.dev
#   ❌ Incorrect: https://your-worker.workers.dev/  (NO TRAILING SLASH!)
#
# This URL is used to construct OAuth redirect URIs:
#   - YouTube:  {BASE_URL}/api/auth/callback/youtube
#   - TikTok:   {BASE_URL}/api/auth/callback/tiktok
#   - Facebook: {BASE_URL}/api/auth/callback/facebook
#
# IMPORTANT: The BASE_URL MUST match EXACTLY what's registered in your
# OAuth provider consoles (Google Cloud, TikTok Developer, Meta Developer)
# ============================================================================
BASE_URL=https://your-worker.workers.dev

# Frontend URL (OPTIONAL - only if HTML files hosted separately)
# Where users are redirected after OAuth completes
# Example: https://multipostapp.co.uk (if using GitHub Pages)
# If not set, users will be redirected to BASE_URL
#
# IMPORTANT: NO TRAILING SLASH!
#   ✅ Correct:   https://your-frontend-domain.com
#   ❌ Incorrect: https://your-frontend-domain.com/
FRONTEND_URL=https://your-frontend-domain.com

# Google OAuth (YouTube)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# TikTok OAuth
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Facebook OAuth
FB_CLIENT_ID=1596560914709231
FB_CLIENT_SECRET=762eebd35d5d0e823f8d91861908d362
