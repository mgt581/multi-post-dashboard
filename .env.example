# Cloudflare Worker Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Base URL for OAuth callbacks (REQUIRED for consistent redirect URIs)
# This should match your primary domain where the app is accessed
# Example: https://multipostapp.co.uk or https://your-worker.workers.dev
BASE_URL=https://your-domain.com

# Google OAuth (YouTube)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# TikTok OAuth
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Facebook OAuth
FB_CLIENT_ID=1596560914709231
FB_CLIENT_SECRET=762eebd35d5d0e823f8d91861908d362
